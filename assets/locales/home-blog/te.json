{
  "about": "\u0c17\u0c41\u0c30\u0c3f\u0c02\u0c1a\u0c3f",
  "aboutBody": "\u0c2a\u0c4d\u0c30\u0c24\u0c3f \u0c35\u0c4d\u0c2f\u0c3e\u0c2a\u0c3e\u0c30\u0c02 \u0c35\u0c46\u0c28\u0c41\u0c15, \u0c2a\u0c4d\u0c30\u0c24\u0c3f\u0c26\u0c40 \u0c38\u0c1c\u0c3e\u0c35\u0c41\u0c17\u0c3e \u0c38\u0c3e\u0c17\u0c47\u0c32\u0c3e \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c2a\u0c4d\u0c30\u0c2f\u0c24\u0c4d\u0c28\u0c3f\u0c02\u0c1a\u0c47 \u0c35\u0c3e\u0c30\u0c41 \u0c09\u0c02\u0c1f\u0c3e\u0c30\u0c41. \u0c2a\u0c47\u0c2a\u0c30\u0c4d \u0c1f\u0c4d\u0c30\u0c48\u0c32\u0c4d, \u0c2c\u0c41\u0c15\u0c4d\u200c\u0c15\u0c40\u0c2a\u0c3f\u0c02\u0c17\u0c4d \u0c2e\u0c30\u0c2e\u0c4d\u0c2e\u0c24\u0c41\u0c32\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c38\u0c02\u0c16\u0c4d\u0c2f\u0c32\u0c15\u0c41 \u0c05\u0c30\u0c4d\u0c25\u0c02 \u0c35\u0c1a\u0c4d\u0c1a\u0c47\u0c32\u0c3e \u0c38\u0c39\u0c3e\u0c2f\u0c2a\u0c21\u0c47 \u0c28\u0c46\u0c32\u0c35\u0c3e\u0c30\u0c40 \u0c2e\u0c26\u0c4d\u0c26\u0c24\u0c41\u0c24\u0c4b, \u0c06\u0c30\u0c4d\u0c25\u0c3f\u0c15 \u0c30\u0c3f\u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c41\u0c32\u0c15\u0c41 \u0c12\u0c15 \u0c15\u0c4d\u0c30\u0c2e\u0c2a\u0c26\u0c4d\u0c27\u0c24\u0c3f\u0c28\u0c3f \u0c05\u0c02\u0c26\u0c3f\u0c38\u0c4d\u0c24\u0c41\u0c02\u0c26\u0c3f.",
  "aboutClosing": "\u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c15\u0c30\u0c2e\u0c48\u0c28 \u0c30\u0c3f\u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c41\u0c32\u0c41. \u0c38\u0c4d\u0c2a\u0c37\u0c4d\u0c1f\u0c2e\u0c48\u0c28 \u0c35\u0c3f\u0c35\u0c30\u0c23\u0c32\u0c41. \u0c26\u0c43\u0c37\u0c4d\u0c1f\u0c3f \u0c15\u0c47\u0c02\u0c26\u0c4d\u0c30\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c2e\u0c30\u0c3f\u0c15\u0c4a\u0c02\u0c24 \u0c05\u0c35\u0c15\u0c3e\u0c36\u0c02.",
  "aboutPaperTrail": "\u0c2a\u0c47\u0c2a\u0c30\u0c4d \u0c1f\u0c4d\u0c30\u0c48\u0c32\u0c4d \u0c17\u0c41\u0c30\u0c3f\u0c02\u0c1a\u0c3f",
  "allNotes": "\u0c05\u0c28\u0c4d\u0c28\u0c3f \u0c17\u0c2e\u0c28\u0c3f\u0c15\u0c32\u0c41",
  "allServices": "\u0c05\u0c28\u0c4d\u0c28\u0c3f \u0c38\u0c47\u0c35\u0c32\u0c41",
  "balancing": "\u0c38\u0c2e\u0c24\u0c41\u0c32\u0c4d\u0c2f\u0c02 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c26\u0c3f\u0c26\u0c4d\u0c26\u0c41\u0c2c\u0c3e\u0c1f\u0c4d\u0c32\u0c41",
  "bank": "\u0c2c\u0c4d\u0c2f\u0c3e\u0c02\u0c15\u0c4d & \u0c15\u0c4d\u0c30\u0c46\u0c21\u0c3f\u0c1f\u0c4d \u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c4d \u0c2c\u0c4d\u0c2f\u0c3e\u0c32\u0c46\u0c28\u0c4d\u0c38\u0c3f\u0c02\u0c17\u0c4d",
  "blog": "\u0c2c\u0c4d\u0c32\u0c3e\u0c17\u0c4d",
  "blogPreview0": "\u0c24\u0c2a\u0c4d\u0c2a\u0c3f\u0c2a\u0c4b\u0c2f\u0c3f\u0c28 \u0c30\u0c3f\u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c41\u0c32\u0c28\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c1a\u0c3f\u0c35\u0c30\u0c3f\u0c17\u0c3e \u0c2a\u0c42\u0c30\u0c4d\u0c24\u0c3f \u0c1a\u0c47\u0c38\u0c3f\u0c28 \u0c28\u0c46\u0c32\u0c28\u0c41 \u0c17\u0c41\u0c30\u0c4d\u0c24\u0c3f\u0c02\u0c1a\u0c21\u0c02\u0c24\u0c4b \u0c17\u0c21\u0c41\u0c35\u0c41 \u0c2e\u0c40\u0c30\u0c3f\u0c28 \u0c2c\u0c41\u0c15\u0c4d\u200c\u0c15\u0c40\u0c2a\u0c3f\u0c02\u0c17\u0c4d \u0c2a\u0c4d\u0c30\u0c3e\u0c30\u0c02\u0c2d\u0c2e\u0c35\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f. \u0c2c\u0c15\u0c3e\u0c2f\u0c3f\u0c32\u0c28\u0c41 \u0c24\u0c40\u0c30\u0c4d\u0c1a\u0c47 \u0c2a\u0c4d\u0c30\u0c23\u0c3e\u0c33\u0c3f\u0c15\u0c32\u0c4b \u0c38\u0c4d\u0c1f\u0c47\u0c1f\u0c4d\u200c\u0c2e\u0c46\u0c02\u0c1f\u0c4d\u200c\u0c32\u0c41, \u0c30\u0c38\u0c40\u0c26\u0c41\u0c32\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c30\u0c3f\u0c15\u0c28\u0c4d\u0c38\u0c3f\u0c32\u0c3f\u0c2f\u0c47\u0c37\u0c28\u0c4d\u200c\u0c32\u0c41 \u0c0e\u0c32\u0c3e \u0c07\u0c2e\u0c3f\u0c21\u0c3f \u0c09\u0c02\u0c1f\u0c3e\u0c2f\u0c4b \u0c1a\u0c42\u0c21\u0c02\u0c21\u0c3f.",
  "blogPreview1": "\u0c32\u0c3e\u0c2d\u0c02 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c28\u0c17\u0c26\u0c41 \u0c2a\u0c4d\u0c30\u0c35\u0c3e\u0c39\u0c02 \u0c2e\u0c40 \u0c35\u0c4d\u0c2f\u0c3e\u0c2a\u0c3e\u0c30 \u0c06\u0c30\u0c4d\u0c25\u0c3f\u0c15 \u0c35\u0c4d\u0c2f\u0c35\u0c39\u0c3e\u0c30\u0c3e\u0c32\u0c32\u0c4b\u0c28\u0c3f \u0c35\u0c47\u0c30\u0c4d\u0c35\u0c47\u0c30\u0c41 \u0c2d\u0c3e\u0c17\u0c3e\u0c32\u0c28\u0c41 \u0c35\u0c3f\u0c35\u0c30\u0c3f\u0c38\u0c4d\u0c24\u0c3e\u0c2f\u0c3f. \u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c3f\u0c02\u0c1a\u0c28\u0c3f \u0c07\u0c28\u0c4d\u200c\u0c35\u0c3e\u0c2f\u0c3f\u0c38\u0c4d\u200c\u0c32\u0c41, \u0c2c\u0c3f\u0c32\u0c4d\u0c32\u0c41\u0c32\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c38\u0c2e\u0c2f\u0c2a\u0c3e\u0c32\u0c28 \u0c35\u0c02\u0c1f\u0c3f\u0c35\u0c3f \u0c32\u0c3e\u0c2d\u0c26\u0c3e\u0c2f\u0c15\u0c2e\u0c48\u0c28 \u0c35\u0c4d\u0c2f\u0c3e\u0c2a\u0c3e\u0c30\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c28\u0c17\u0c26\u0c41 \u0c15\u0c4a\u0c30\u0c24\u0c15\u0c41 \u0c0e\u0c32\u0c3e \u0c17\u0c41\u0c30\u0c3f\u0c1a\u0c47\u0c38\u0c4d\u0c24\u0c3e\u0c2f\u0c4b \u0c24\u0c46\u0c32\u0c41\u0c38\u0c41\u0c15\u0c4b\u0c02\u0c21\u0c3f.",
  "blogPreview2": "\u0c15\u0c4d\u0c30\u0c2e\u0c2c\u0c26\u0c4d\u0c27\u0c02\u0c17\u0c3e \u0c05\u0c2e\u0c30\u0c4d\u0c1a\u0c3f\u0c28 \u0c2a\u0c41\u0c38\u0c4d\u0c24\u0c15\u0c3e\u0c32\u0c41 \u0c2e\u0c40 \u0c2a\u0c28\u0c4d\u0c28\u0c41 \u0c38\u0c32\u0c39\u0c3e\u0c26\u0c3e\u0c30\u0c41\u0c28\u0c3f\u0c15\u0c3f \u0c06\u0c26\u0c3e\u0c2f\u0c02, \u0c16\u0c30\u0c4d\u0c1a\u0c41\u0c32\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c16\u0c3e\u0c24\u0c3e \u0c28\u0c3f\u0c32\u0c4d\u0c35\u0c32\u0c28\u0c41 \u0c17\u0c41\u0c30\u0c4d\u0c24\u0c3f\u0c02\u0c1a\u0c21\u0c02\u0c32\u0c4b \u0c38\u0c39\u0c3e\u0c2f\u0c2a\u0c21\u0c24\u0c3e\u0c2f\u0c3f. \u0c2a\u0c28\u0c4d\u0c28\u0c41 \u0c2c\u0c26\u0c3f\u0c32\u0c40\u0c15\u0c3f \u0c2e\u0c41\u0c02\u0c26\u0c41 \u0c38\u0c47\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c3e\u0c32\u0c4d\u0c38\u0c3f\u0c28 \u0c28\u0c3f\u0c35\u0c47\u0c26\u0c3f\u0c15\u0c32\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c38\u0c39\u0c3e\u0c2f\u0c15 \u0c30\u0c3f\u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c41\u0c32\u0c28\u0c41 \u0c38\u0c2e\u0c40\u0c15\u0c4d\u0c37\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f.",
  "blogTitle0": "\u0c2c\u0c15\u0c3e\u0c2f\u0c3f\u0c2a\u0c21\u0c3f\u0c28 \u0c2a\u0c41\u0c38\u0c4d\u0c24\u0c15\u0c3e\u0c32\u0c28\u0c41 \u0c38\u0c30\u0c3f\u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f: \u0c28\u0c46\u0c32\u0c32 \u0c24\u0c30\u0c2c\u0c21\u0c3f \u0c17\u0c21\u0c41\u0c35\u0c41 \u0c26\u0c3e\u0c1f\u0c3f\u0c28 \u0c2a\u0c41\u0c38\u0c4d\u0c24\u0c15\u0c3e\u0c32\u0c28\u0c41 \u0c24\u0c3e\u0c1c\u0c3e\u0c17\u0c3e \u0c09\u0c02\u0c1a\u0c02\u0c21\u0c3f",
  "blogTitle1": "\u0c32\u0c3e\u0c2d\u0c02 vs. \u0c28\u0c17\u0c26\u0c41 \u0c2a\u0c4d\u0c30\u0c35\u0c3e\u0c39\u0c02: \u0c2e\u0c40 \u0c35\u0c4d\u0c2f\u0c3e\u0c2a\u0c3e\u0c30 \u0c21\u0c2c\u0c4d\u0c2c\u0c41 \u0c0e\u0c15\u0c4d\u0c15\u0c21\u0c3f\u0c15\u0c3f \u0c35\u0c46\u0c33\u0c4d\u0c24\u0c4b\u0c02\u0c26\u0c3f",
  "blogTitle2": "\u0c2a\u0c28\u0c4d\u0c28\u0c41\u0c15\u0c41 \u0c38\u0c3f\u0c26\u0c4d\u0c27\u0c02\u0c17\u0c3e \u0c09\u0c02\u0c21\u0c47 \u0c2c\u0c41\u0c15\u0c4d\u200c\u0c15\u0c40\u0c2a\u0c3f\u0c02\u0c17\u0c4d: \u0c2b\u0c48\u0c32\u0c4d \u0c1a\u0c47\u0c38\u0c47 \u0c2e\u0c41\u0c02\u0c26\u0c41 \u0c2e\u0c40 \u0c30\u0c3f\u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c41\u0c32\u0c28\u0c41 \u0c15\u0c4d\u0c30\u0c2e\u0c2c\u0c26\u0c4d\u0c27\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f",
  "captureFirstName": "\u0c2e\u0c4a\u0c26\u0c1f\u0c3f \u0c2a\u0c47\u0c30\u0c41",
  "captureLastName": "\u0c1a\u0c3f\u0c35\u0c30\u0c3f \u0c2a\u0c47\u0c30\u0c41",
  "captureMessage": "\u0c38\u0c02\u0c26\u0c47\u0c36\u0c02",
  "captureSubmit": "\u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f",
  "catchUp": "\u0c17\u0c21\u0c41\u0c35\u0c41 \u0c26\u0c3e\u0c1f\u0c3f\u0c28 \u0c2a\u0c41\u0c38\u0c4d\u0c24\u0c15\u0c3e\u0c32\u0c28\u0c41 \u0c2a\u0c42\u0c30\u0c4d\u0c24\u0c3f \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f",
  "categorization": "\u0c32\u0c3e\u0c35\u0c3e\u0c26\u0c47\u0c35\u0c40 \u0c35\u0c30\u0c4d\u0c17\u0c40\u0c15\u0c30\u0c23",
  "chatClose": "\u0c38\u0c28\u0c4d\u0c28\u0c3f\u0c39\u0c3f\u0c24 \u0c38\u0c02\u0c2d\u0c3e\u0c37\u0c23",
  "chatContinue": "\u0c28\u0c3e \u0c28\u0c4b\u0c1f\u0c4d\u200c\u0c28\u0c41 \u0c38\u0c3f\u0c26\u0c4d\u0c27\u0c02 \u0c1a\u0c47\u0c2f\u0c21\u0c02 \u0c15\u0c4a\u0c28\u0c38\u0c3e\u0c17\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f",
  "chatHelp": "\u0c26\u0c40\u0c28\u0c4d\u0c28\u0c3f \u0c05\u0c30\u0c4d\u0c25\u0c02 \u0c1a\u0c47\u0c38\u0c41\u0c15\u0c4b\u0c35\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c28\u0c3e\u0c15\u0c41 \u0c38\u0c39\u0c3e\u0c2f\u0c02 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f",
  "chatReply": "\u0c2a\u0c4d\u0c30\u0c24\u0c4d\u0c2f\u0c41\u0c24\u0c4d\u0c24\u0c30\u0c02 \u0c30\u0c3e\u0c2f\u0c02\u0c21\u0c3f\u2026",
  "chatReset": "\u0c2e\u0c33\u0c4d\u0c33\u0c40 \u0c2a\u0c4d\u0c30\u0c3e\u0c30\u0c02\u0c2d\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f",
  "chatSend": "\u0c2a\u0c02\u0c2a\u0c02\u0c21\u0c3f",
  "contact": "\u0c2e\u0c2e\u0c4d\u0c2e\u0c32\u0c4d\u0c28\u0c3f \u0c38\u0c02\u0c2a\u0c4d\u0c30\u0c26\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f",
  "copied": "\u0c07\u0c2e\u0c46\u0c2f\u0c3f\u0c32\u0c4d \u0c1a\u0c3f\u0c30\u0c41\u0c28\u0c3e\u0c2e\u0c3e \u0c15\u0c3e\u0c2a\u0c40 \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c3f\u0c02\u0c26\u0c3f.",
  "copyEmail": "\u0c07\u0c2e\u0c46\u0c2f\u0c3f\u0c32\u0c4d \u0c1a\u0c3f\u0c30\u0c41\u0c28\u0c3e\u0c2e\u0c3e\u0c28\u0c41 \u0c15\u0c3e\u0c2a\u0c40 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f",
  "copyright": "\u00a9 2026 \u0c2a\u0c47\u0c2a\u0c30\u0c4d \u0c1f\u0c4d\u0c30\u0c48\u0c32\u0c4d. \u0c38\u0c30\u0c4d\u0c35 \u0c39\u0c15\u0c4d\u0c15\u0c41\u0c32\u0c41 \u0c38\u0c02\u0c30\u0c15\u0c4d\u0c37\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c3f\u0c28\u0c35\u0c3f.",
  "credit": "\u0c38\u0c4d\u0c1f\u0c3e\u0c30\u0c4d\u0c1f\u0c4d\u200c\u0c35\u0c46\u0c2c\u0c4d7 \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c35\u0c46\u0c2c\u0c4d \u0c21\u0c3f\u0c1c\u0c48\u0c28\u0c4d \u0c2e\u0c30\u0c3f\u0c2f\u0c41 SEO",
  "defaultEmail": "\u0c21\u0c3f\u0c2b\u0c3e\u0c32\u0c4d\u0c1f\u0c4d \u0c07\u0c2e\u0c46\u0c2f\u0c3f\u0c32\u0c4d \u0c2f\u0c3e\u0c2a\u0c4d",
  "emailTitle": "\u0c08\u0c2e\u0c46\u0c2f\u0c3f\u0c32\u0c4d \u0c2a\u0c47\u0c2a\u0c30\u0c4d \u0c1f\u0c4d\u0c30\u0c46\u0c2f\u0c3f\u0c32\u0c4d",
  "englishNote": "\u0c2a\u0c42\u0c30\u0c4d\u0c24\u0c3f \u0c2a\u0c3e\u0c20\u0c4d\u0c2f\u0c02 \u0c06\u0c02\u0c17\u0c4d\u0c32\u0c02\u0c32\u0c4b \u0c05\u0c02\u0c26\u0c41\u0c2c\u0c3e\u0c1f\u0c41\u0c32\u0c4b \u0c09\u0c02\u0c26\u0c3f.",
  "hero": "\u0c2c\u0c41\u0c15\u0c4d\u200c\u0c15\u0c40\u0c2a\u0c3f\u0c02\u0c17\u0c4d",
  "heroDescription": "\u0c17\u0c21\u0c41\u0c35\u0c41 \u0c2e\u0c40\u0c30\u0c3f\u0c28 \u0c30\u0c3f\u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c41\u0c32 \u0c28\u0c41\u0c02\u0c21\u0c3f \u0c28\u0c46\u0c32\u0c35\u0c3e\u0c30\u0c40 \u0c28\u0c3f\u0c35\u0c47\u0c26\u0c3f\u0c15\u0c32 \u0c35\u0c30\u0c15\u0c41, \u0c06\u0c26\u0c3e\u0c2f\u0c02, \u0c16\u0c30\u0c4d\u0c1a\u0c41\u0c32\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c16\u0c3e\u0c24\u0c3e \u0c28\u0c3f\u0c32\u0c4d\u0c35\u0c32\u0c28\u0c41 \u0c2a\u0c30\u0c4d\u0c2f\u0c35\u0c47\u0c15\u0c4d\u0c37\u0c3f\u0c02\u0c1a\u0c21\u0c02\u0c32\u0c4b \u0c2e\u0c47\u0c2e\u0c41 \u0c2e\u0c40\u0c15\u0c41 \u0c38\u0c39\u0c3e\u0c2f\u0c02 \u0c1a\u0c47\u0c38\u0c4d\u0c24\u0c3e\u0c2e\u0c41.",
  "home": "\u0c39\u0c4b\u0c2e\u0c4d",
  "homeNote0": "\u0c12\u0c15 \u0c35\u0c4d\u0c2f\u0c3e\u0c2a\u0c3e\u0c30\u0c02 \u0c15\u0c4b\u0c38\u0c02 \u0c2c\u0c41\u0c15\u0c4d\u200c\u0c15\u0c40\u0c2a\u0c30\u0c4d \u0c28\u0c3f\u0c30\u0c4d\u0c35\u0c39\u0c3f\u0c02\u0c1a\u0c47 \u0c2a\u0c28\u0c3f",
  "homeNote1": "\u0c35\u0c3f\u0c36\u0c4d\u0c35\u0c38\u0c28\u0c40\u0c2f\u0c2e\u0c48\u0c28 \u0c2c\u0c4d\u0c2f\u0c3e\u0c02\u0c15\u0c4d \u0c30\u0c3f\u0c15\u0c28\u0c4d\u0c38\u0c3f\u0c32\u0c3f\u0c2f\u0c47\u0c37\u0c28\u0c4d \u0c35\u0c3f\u0c27\u0c3e\u0c28\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c0f\u0c30\u0c4d\u0c2a\u0c3e\u0c1f\u0c41 \u0c1a\u0c47\u0c38\u0c41\u0c15\u0c4b\u0c02\u0c21\u0c3f",
  "homeNote2": "\u0c15\u0c4d\u0c30\u0c2e\u0c02 \u0c24\u0c2a\u0c4d\u0c2a\u0c15\u0c41\u0c02\u0c21\u0c3e \u0c1f\u0c4d\u0c30\u0c3e\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c3e\u0c32\u0c4d\u0c38\u0c3f\u0c28 \u0c35\u0c4d\u0c2f\u0c3e\u0c2a\u0c3e\u0c30 \u0c16\u0c30\u0c4d\u0c1a\u0c41\u0c32\u0c41",
  "homeNote3": "\u0c2e\u0c40 \u0c2a\u0c28\u0c4d\u0c28\u0c41 \u0c38\u0c32\u0c39\u0c3e\u0c26\u0c3e\u0c30\u0c41\u0c15\u0c41 \u0c15\u0c4d\u0c30\u0c2e\u0c2c\u0c26\u0c4d\u0c27\u0c2e\u0c48\u0c28 \u0c2a\u0c41\u0c38\u0c4d\u0c24\u0c15\u0c3e\u0c32 \u0c38\u0c2e\u0c3f\u0c24\u0c3f\u0c28\u0c3f \u0c07\u0c35\u0c4d\u0c35\u0c02\u0c21\u0c3f",
  "income": "\u0c06\u0c26\u0c3e\u0c2f & \u0c35\u0c4d\u0c2f\u0c2f \u0c1f\u0c4d\u0c30\u0c3e\u0c15\u0c3f\u0c02\u0c17\u0c4d",
  "keepCurrent": "\u0c28\u0c46\u0c32\u0c35\u0c3e\u0c30\u0c40 \u0c30\u0c3f\u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c41\u0c32\u0c28\u0c41 \u0c0e\u0c2a\u0c4d\u0c2a\u0c1f\u0c3f\u0c15\u0c2a\u0c4d\u0c2a\u0c41\u0c21\u0c41 \u0c24\u0c3e\u0c1c\u0c3e\u0c17\u0c3e \u0c09\u0c02\u0c1a\u0c02\u0c21\u0c3f",
  "language": "\u0c2d\u0c3e\u0c37",
  "location": "\u0c26\u0c47\u0c36\u0c35\u0c4d\u0c2f\u0c3e\u0c2a\u0c4d\u0c24\u0c02\u0c17\u0c3e \u2013 \u0c32\u0c3e\u0c38\u0c4d \u0c0f\u0c02\u0c1c\u0c3f\u0c32\u0c4d\u0c38\u0c4d, \u0c15\u0c3e\u0c32\u0c3f\u0c2b\u0c4b\u0c30\u0c4d\u0c28\u0c3f\u0c2f\u0c3e \u0c15\u0c47\u0c02\u0c26\u0c4d\u0c30\u0c02\u0c17\u0c3e",
  "mobileBlogSupport": "\u0c2e\u0c40 \u0c2c\u0c41\u0c15\u0c4d\u0c15\u0c40\u0c2a\u0c3f\u0c02\u0c17\u0c4d \u0c05\u0c35\u0c38\u0c30\u0c3e\u0c32 \u0c17\u0c41\u0c30\u0c3f\u0c02\u0c1a\u0c3f \u0c2a\u0c47\u0c2a\u0c30\u0c4d \u0c1f\u0c4d\u0c30\u0c48\u0c32\u0c4d\u200c\u0c15\u0c41 \u0c24\u0c46\u0c32\u0c3f\u0c2f\u0c1c\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c1a\u0c3e\u0c1f\u0c4d\u200c\u0c28\u0c41 \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f.",
  "mobileSupport": "\u0c2c\u0c41\u0c15\u0c4d\u0c15\u0c40\u0c2a\u0c3f\u0c02\u0c17\u0c4d \u0c38\u0c39\u0c3e\u0c2f\u0c02 \u0c2a\u0c4a\u0c02\u0c26\u0c02\u0c21\u0c3f",
  "monthly": "\u0c28\u0c46\u0c32\u0c35\u0c3e\u0c30\u0c40 \u0c2c\u0c41\u0c15\u0c4d\u200c\u0c15\u0c40\u0c2a\u0c3f\u0c02\u0c17\u0c4d",
  "monthlyOverview": "\u0c28\u0c46\u0c32\u0c35\u0c3e\u0c30\u0c40 \u0c2c\u0c41\u0c15\u0c4d\u0c15\u0c40\u0c2a\u0c3f\u0c02\u0c17\u0c4d \u0c05\u0c35\u0c32\u0c4b\u0c15\u0c28\u0c02",
  "notes": "\u0c17\u0c2e\u0c28\u0c3f\u0c15\u0c32\u0c41",
  "notice": "\u0c08 \u0c2d\u0c3e\u0c37\u0c32\u0c4b \u0c39\u0c4b\u0c2e\u0c4d \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c2c\u0c4d\u0c32\u0c3e\u0c17\u0c4d \u0c2a\u0c47\u0c1c\u0c40\u0c32\u0c41 \u0c2e\u0c3e\u0c24\u0c4d\u0c30\u0c2e\u0c47 \u0c05\u0c02\u0c26\u0c41\u0c2c\u0c3e\u0c1f\u0c41\u0c32\u0c4b \u0c09\u0c28\u0c4d\u0c28\u0c3e\u0c2f\u0c3f.",
  "pastDue": "\u0c17\u0c21\u0c41\u0c35\u0c41 \u0c26\u0c3e\u0c1f\u0c3f\u0c28 \u0c2c\u0c41\u0c15\u0c4d\u200c\u0c15\u0c40\u0c2a\u0c3f\u0c02\u0c17\u0c4d",
  "payables": "\u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c3f\u0c02\u0c1a\u0c35\u0c32\u0c38\u0c3f\u0c28 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c38\u0c4d\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c35\u0c32\u0c38\u0c3f\u0c28 \u0c16\u0c3e\u0c24\u0c3e\u0c32\u0c41",
