  "reports": "\u0c28\u0c46\u0c32\u0c35\u0c3e\u0c30\u0c40 \u0c06\u0c30\u0c4d\u0c25\u0c3f\u0c15 \u0c28\u0c3f\u0c35\u0c47\u0c26\u0c3f\u0c15\u0c32\u0c41",
  "review": "\u0c28\u0c46\u0c32\u0c35\u0c3e\u0c30\u0c40 \u0c2c\u0c41\u0c15\u0c4d\u0c15\u0c40\u0c2a\u0c3f\u0c02\u0c17\u0c4d \u0c38\u0c2e\u0c40\u0c15\u0c4d\u0c37",
  "services": "\u0c38\u0c47\u0c35\u0c32\u0c41",
  "talk": "\u0c2a\u0c47\u0c2a\u0c30\u0c4d \u0c1f\u0c4d\u0c30\u0c48\u0c32\u0c4d\u200c\u0c24\u0c4b \u0c2e\u0c3e\u0c1f\u0c4d\u0c32\u0c3e\u0c21\u0c02\u0c21\u0c3f",
  "taxReady": "\u0c2a\u0c28\u0c4d\u0c28\u0c41\u0c15\u0c41 \u0c38\u0c3f\u0c26\u0c4d\u0c27\u0c02\u0c17\u0c3e \u0c09\u0c28\u0c4d\u0c28 \u0c2c\u0c41\u0c15\u0c4d\u0c15\u0c40\u0c2a\u0c3f\u0c02\u0c17\u0c4d",
  "viewMonthly": "\u0c28\u0c46\u0c32\u0c35\u0c3e\u0c30\u0c40\u0c17\u0c3e \u0c35\u0c40\u0c15\u0c4d\u0c37\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f",
  "viewRepair": "\u0c2e\u0c30\u0c2e\u0c4d\u0c2e\u0c24\u0c41\u0c28\u0c41 \u0c35\u0c40\u0c15\u0c4d\u0c37\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f",
  "viewService": "\u0c38\u0c47\u0c35\u0c28\u0c41 \u0c35\u0c40\u0c15\u0c4d\u0c37\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f",
  "yearEnd": "\u0c38\u0c02\u0c35\u0c24\u0c4d\u0c38\u0c30\u0c3e\u0c02\u0c24\u0c2a\u0c41 \u0c2c\u0c41\u0c15\u0c4d\u0c15\u0c40\u0c2a\u0c3f\u0c02\u0c17\u0c4d"
